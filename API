package com.yourcompany.plugin.http;

/**
 * Stocke la configuration de session pour l'API REST.
 * Instancier une fois, passer en paramètre à ApiClient.
 */
public class ApiSession {

    private final String baseUrl;
    private final String personalAccessToken;

    private ApiSession(Builder builder) {
        this.baseUrl = builder.baseUrl;
        this.personalAccessToken = builder.personalAccessToken;
    }

    public String getBaseUrl() {
        return baseUrl;
    }

    public String getBearerToken() {
        // Format standard Authorization header
        return "Bearer " + personalAccessToken;
    }

    // --- Builder pattern pour une construction lisible ---

    public static Builder builder() {
        return new Builder();
    }

    public static class Builder {
        private String baseUrl;
        private String personalAccessToken;

        public Builder baseUrl(String baseUrl) {
            // Supprime le slash final pour éviter les doubles //
            this.baseUrl = baseUrl.endsWith("/")
                ? baseUrl.substring(0, baseUrl.length() - 1)
                : baseUrl;
            return this;
        }

        public Builder personalAccessToken(String token) {
            this.personalAccessToken = token;
            return this;
        }

        public ApiSession build() {
            Objects.requireNonNull(baseUrl, "baseUrl is required");
            Objects.requireNonNull(personalAccessToken, "token is required");
            return new ApiSession(this);
        }
    }
}


package com.yourcompany.plugin.http;

/**
 * Centralise toutes les routes de l'API.
 * Utiliser String.format() ou les méthodes utilitaires pour les routes paramétrées.
 */
public final class ApiRoutes {

    private ApiRoutes() {} // Classe utilitaire, pas d'instanciation

    // --- Routes statiques ---
    public static final String PROJECTS       = "/api/projects";
    public static final String CURRENT_USER   = "/api/user";

