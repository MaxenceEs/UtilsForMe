        return "/api/projects/" + projectId + "/models/" + modelId;
    }
}


package com.yourcompany.plugin.http;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpRequest.BodyPublishers;
import java.net.http.HttpResponse;
import java.net.http.HttpResponse.BodyHandlers;
import java.time.Duration;

/**
 * Client HTTP configuré pour l'API REST.
 * Thread-safe : le HttpClient sous-jacent est réutilisable.
 */
public class ApiClient {

    private final ApiSession session;
    private final HttpClient httpClient;

    public ApiClient(ApiSession session) {
        this.session = session;
        this.httpClient = HttpClient.newBuilder()
                .connectTimeout(Duration.ofSeconds(10))
                .build();
    }

    // =========================================================
    //  Méthodes publiques — une par verbe HTTP
    // =========================================================

    public ApiResponse get(String route) throws ApiException {
        HttpRequest request = baseRequest(route)
                .GET()
                .build();
        return send(request);
    }

    public ApiResponse post(String route, String jsonBody) throws ApiException {
        HttpRequest request = baseRequest(route)
                .POST(BodyPublishers.ofString(jsonBody))
                .build();
        return send(request);
    }

    public ApiResponse put(String route, String jsonBody) throws ApiException {
        HttpRequest request = baseRequest(route)
                .PUT(BodyPublishers.ofString(jsonBody))
                .build();
        return send(request);
    }

    public ApiResponse delete(String route) throws ApiException {
        HttpRequest request = baseRequest(route)
                .DELETE()
                .build();
        return send(request);
    }

    // =========================================================
    //  Méthodes privées
    // =========================================================

    /**
     * Construit la base de chaque requête : URL complète + headers communs.
     */
    private HttpRequest.Builder baseRequest(String route) {
        URI uri = URI.create(session.getBaseUrl() + route);
        return HttpRequest.newBuilder()
                .uri(uri)
                .timeout(Duration.ofSeconds(30))
                .header("Authorization", session.getBearerToken())
                .header("Content-Type", "application/json")
                .header("Accept", "application/json");
    }

    /**
     * Envoie la requête et encapsule la réponse ou l'erreur.
     */
    private ApiResponse send(HttpRequest request) throws ApiException {
        try {
            HttpResponse<String> response =
                httpClient.send(request, BodyHandlers.ofString());

            if (response.statusCode() >= 400) {
                throw new ApiException(
                    "HTTP " + response.statusCode() + " on " + request.uri(),
                    response.statusCode(),
                    response.body()
                );
            }
            return new ApiResponse(response.statusCode(), response.body());

        } catch (ApiException e) {
            throw e; // Re-throw, pas de wrapping double
        } catch (Exception e) {
            throw new ApiException("Request failed: " + e.getMessage(), e);
        }
    }
}


// ApiResponse.java
public record ApiResponse(int statusCode, String body) {
    public boolean isSuccess() {
        return statusCode >= 200 && statusCode < 300;
    }
}

// ApiException.java
public class ApiException extends Exception {
    private final int httpStatus;    // 0 si erreur réseau
    private final String responseBody;

    public ApiException(String message, int httpStatus, String responseBody) {
        super(message);
        this.httpStatus = httpStatus;
        this.responseBody = responseBody;
    }

    public ApiException(String message, Throwable cause) {
        super(message, cause);
        this.httpStatus = 0;
        this.responseBody = null;
    }

    // getters...
}



